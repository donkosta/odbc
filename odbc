CREATE TABLE public.payments (
    payment_id     SERIAL PRIMARY KEY,
    customer_id    INTEGER NOT NULL,
    amount         NUMERIC(12,2) NOT NULL,
    payment_status VARCHAR(30) NOT NULL,
    created_at     TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

